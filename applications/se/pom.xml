<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.helidon.applications</groupId>
        <artifactId>helidon-se</artifactId>
        <version>4.5.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>com.oracle.helidon.oci</groupId>
    <artifactId>helidon-oci-se</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Helidon OCI SE Applications</name>
    <description>Helidon OCI SE applications</description>

    <properties>
        <helidon.oci.version>2.0.0-SNAPSHOT</helidon.oci.version>
        <version.plugin.compiler>3.14.1</version.plugin.compiler>
        <version.plugin.failsafe>3.5.5</version.plugin.failsafe>
        <version.plugin.maven-build-helper-plugin>3.4.0</version.plugin.maven-build-helper-plugin>
        <version.plugin.openapi-generator-maven-plugin>7.11.0</version.plugin.openapi-generator-maven-plugin>
        <version.plugin.splat-swagger-maven-plugin>0.3.9</version.plugin.splat-swagger-maven-plugin>
        <version.plugin.surefire>3.5.5</version.plugin.surefire>
        <version.lib.classgraph>4.8.184</version.lib.classgraph>
        <jersey-lib-version>2.47</jersey-lib-version>
        <version.lib.logback>1.5.32</version.lib.logback>
        <version.lib.mockito>5.22.0</version.lib.mockito>
        <version.lib.slf4j>2.0.9</version.lib.slf4j>
        <version.helidon.extensions.openapi-generator>4.0.0-RC1</version.helidon.extensions.openapi-generator>
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.oracle.helidon.oci</groupId>
                <artifactId>helidon-oci-dependencies</artifactId>
                <version>${helidon.oci.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- The following override versions in parent pom -->
            <dependency>
                <groupId>org.glassfish.jersey.core</groupId>
                <artifactId>jersey-client</artifactId>
                <version>${jersey-lib-version}</version>
            </dependency>
            <dependency>
                <groupId>org.glassfish.jersey.inject</groupId>
                <artifactId>jersey-hk2</artifactId>
                <version>${jersey-lib-version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${version.lib.slf4j}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-core</artifactId>
                <version>${version.lib.logback}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${version.lib.logback}</version>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${version.lib.mockito}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>libs-release</id>
            <name>Artifactory Libs Release</name>
            <url>https://artifactory.oci.oraclecorp.com/libs-release</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
        <repository>
            <id>libs-snapshot</id>
            <name>Artifactory Libs Snapshot</name>
            <url>https://artifactory.oci.oraclecorp.com/libs-snapshot</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <releases>
                <enabled>false</enabled>
            </releases>
        </repository>
        <repository>
            <id>central</id>
            <name>Maven Central Proxy</name>
            <url>https://artifactory.oci.oraclecorp.com/maven-central-maven-remote</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
        <repository>
            <id>central-snapshot</id>
            <name>Maven Central Snapshot Proxy</name>
            <url>https://artifactory.oci.oraclecorp.com/maven-central-snapshot-maven-remote</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <releases>
                <enabled>false</enabled>
            </releases>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>libs-release</id>
            <name>Artifactory Libs Release</name>
            <url>https://artifactory.oci.oraclecorp.com/libs-release</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <releases>
                <enabled>true</enabled>
            </releases>
        </pluginRepository>
        <pluginRepository>
            <id>libs-snapshot</id>
            <name>Artifactory Libs Snapshot</name>
            <url>https://artifactory.oci.oraclecorp.com/libs-snapshot</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <releases>
                <enabled>false</enabled>
            </releases>
        </pluginRepository>
        <pluginRepository>
            <id>central</id>
            <name>Maven Central Proxy</name>
            <url>https://artifactory.oci.oraclecorp.com/maven-central-maven-remote</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <releases>
                <enabled>true</enabled>
            </releases>
        </pluginRepository>
        <pluginRepository>
            <id>central-snapshot</id>
            <name>Maven Central Snapshot Proxy</name>
            <url>https://artifactory.oci.oraclecorp.com/maven-central-snapshot-maven-remote</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <releases>
                <enabled>false</enabled>
            </releases>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <compilerArgs>
                            <arg>-Ahelidon.api.preview=ignore</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>io.helidon.service</groupId>
                    <artifactId>helidon-service-maven-plugin</artifactId>
                    <version>${helidon.version}</version>
                    <configuration>
                        <compilerArgs>
                            <arg>-Ahelidon.api.preview=ignore</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${version.plugin.maven-build-helper-plugin}</version>
                </plugin>
                <plugin>
                    <groupId>org.openapitools</groupId>
                    <artifactId>openapi-generator-maven-plugin</artifactId>
                    <version>${version.plugin.openapi-generator-maven-plugin}</version>
                </plugin>
                <plugin>
                    <groupId>com.oracle.pic.platform.splat</groupId>
                    <artifactId>splat-swagger-maven-plugin</artifactId>
                    <version>${version.plugin.splat-swagger-maven-plugin}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
