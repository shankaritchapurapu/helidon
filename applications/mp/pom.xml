<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.helidon.applications</groupId>
        <artifactId>helidon-mp</artifactId>
        <version>4.1.7-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>com.oracle.helidon.oci</groupId>
    <artifactId>helidon-oci-mp</artifactId>
    <version>1.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Helidon OCI MP Applications</name>
    <description>Helidon OCI MP applications</description>

    <properties>
        <helidon.oci.version>1.1.0-SNAPSHOT</helidon.oci.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.oracle.helidon.oci</groupId>
                <artifactId>helidon-oci-dependencies</artifactId>
                <version>${helidon.oci.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.oracle.helidon.oci</groupId>
                    <artifactId>helidon-oci-swagger-maven-plugin</artifactId>
                    <version>${helidon.oci.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
