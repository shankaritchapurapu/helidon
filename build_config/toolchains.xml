<toolchains>
    <!-- JDK toolchains plugin requires toolchains.xml file, we are referring this file from ocibuild.conf file -->
    <toolchain>
        <type>jdk</type>
        <provides>
            <version>21</version>
        </provides>
        <configuration>
            <jdkHome>/usr/lib/jvm/jdk-21.0.1</jdkHome>
        </configuration>
    </toolchain>
</toolchains>
