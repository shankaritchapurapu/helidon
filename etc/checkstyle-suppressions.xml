<!DOCTYPE suppressions PUBLIC
        "-//Puppy Crawl//DTD Suppressions 1.1//EN"
        "https://checkstyle.sourceforge.net/dtds/suppressions_1_1.dtd">

<!--
Use in Helidon:
This file is used when running the aggregate report (and configuration in modules is ignored in that case).
This file SHOULD ONLY contain exclusions for whole modules where appropriate.
Single check exclusions should be handled through @SuppressWarning("checkstyle:....") annotation.

Only exceptional cases that cannot be handled through annotations may be provided here.
This is to keep the checkstyle exclusions co-located with the code, so if the code changes, we do not leave an outdated
record here.
-->
<suppressions>
    <!--
    - File exclusions (exceptions)
    - FileLength cannot be excluded using a @SuppressWarnings
    -->
    <suppress files="repackaged-oci/javax-shim/src/main/java/com/oracle/helidon/oci/common/javax/jaxrs/shim/Jakarta*"
            checks="MissingJavadocTypeCheck"/>
    <suppress files="repackaged-oci/javax-shim/src/main/java/com/oracle/helidon/oci/common/javax/jaxrs/shim/Javax*"
            checks="MissingJavadocTypeCheck"/>
    <suppress files="repackaged-oci/javax-shim/src/main/java/com/oracle/helidon/oci/common/javax/jaxrs/shim/Jakarta*"
            checks="RedundantModifierCheck"/>
    <suppress files="repackaged-oci/javax-shim/src/main/java/com/oracle/helidon/oci/common/javax/jaxrs/shim/Javax*"
            checks="RedundantModifierCheck"/>
    <suppress files="repackaged-oci/javax-shim/src/main/java/com/oracle/helidon/oci/common/javax/jaxrs/shim/Jakarta*"
            checks="MissingJavadocMethodCheck"/>
    <suppress files="repackaged-oci/javax-shim/src/main/java/com/oracle/helidon/oci/common/javax/jaxrs/shim/Javax*"
            checks="MissingJavadocMethodCheck"/>
    <!-- This is added since its giving extra html tag error even on valid setup. -->
    <suppress files="swagger-maven-plugin/src/main/java/com/oracle/helidon/oci/maven/swagger/OracleSwaggerMojo\.java"
            checks="JavadocStyleCheck"/>
    <!--
    - Module exclusions
    -->
    <suppress files="repackaged-oci/repackaged-oci-vault-java-sdk/*" checks="[a-zA-Z0-9]*"/>
    <suppress files="repackaged-oci/repackaged-oci-authentication-client/*" checks="[a-zA-Z0-9]*"/>

</suppressions>
