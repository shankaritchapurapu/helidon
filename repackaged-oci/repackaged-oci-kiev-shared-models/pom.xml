<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://maven.apache.org/POM/4.0.0"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.oracle.helidon.oci</groupId>
        <artifactId>helidon-repackaged-oci</artifactId>
        <version>1.2.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>helidon-repackaged-oci-kiev-shared-models</artifactId>
    <version>1.2.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Helidon OCI Repackaged OCI kiev-shared-models</name>

    <properties>
        <spotbugs.skip>true</spotbugs.skip>
        <codegen.base.package.name>com.oracle.pic.kiev.api</codegen.base.package.name>
        <frontend-spec-dir>${project.build.directory}/frontend/</frontend-spec-dir>
        <frontend-spec-file>${frontend-spec-dir}/frontend-spec.yaml</frontend-spec-file>
        <client-registry-spec-dir>${project.build.directory}/client-registry/</client-registry-spec-dir>
        <client-registry-spec-file>${client-registry-spec-dir}/client-registry-spec.yaml</client-registry-spec-file>
    </properties>

    <dependencies>
        <!-- https://oci.private.devops.scmservice.us-phoenix-1.oci.oracleiaas.com/namespaces/axuxirvibvvo/projects/KIEV/repositories/kiev-client -->
        <dependency>
            <groupId>com.oracle.pic.kiev</groupId>
            <artifactId>shared-models</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>javax.ws.rs</groupId>
            <artifactId>javax.ws.rs-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oracle.helidon.oci</groupId>
            <artifactId>helidon-oci-javax-shim</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>javax.ws.rs</groupId>
                    <artifactId>javax.ws.rs-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>annotations</artifactId>
            <scope>provided</scope>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oracle.pic.kiev</groupId>
            <artifactId>kiev-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.30</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oracle.oci.sdk</groupId>
            <artifactId>oci-java-sdk-circuitbreaker</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oracle.oci.sdk</groupId>
            <artifactId>oci-java-sdk-common</artifactId>
            <exclusions>
                <exclusion>
                    <artifactId>*</artifactId>
                    <groupId>org.bouncycastle</groupId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.connectors</groupId>
            <artifactId>jersey-apache-connector</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <configuration>
                        <ignoredUnusedDeclaredDependencies>
                            <ignoredUnusedDeclaredDependency>com.oracle.pic.kiev:*-spec</ignoredUnusedDeclaredDependency>
                        </ignoredUnusedDeclaredDependencies>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <!-- Unpack service model specifications. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-kiev-frontend-spec</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.oracle.pic.kiev</groupId>
                                    <artifactId>frontend-spec</artifactId>
                                    <version>2.0.34</version>
                                    <type>jar</type>
                                    <includes>frontend-spec.yaml</includes>
                                    <outputDirectory>${frontend-spec-dir}</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <execution>
                        <id>unpack-kiev-client-registry-spec</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.oracle.pic.kiev</groupId>
                                    <artifactId>client-registry-spec</artifactId>
                                    <version>2.0.34</version>
                                    <type>jar</type>
                                    <includes>client-registry-spec.yaml</includes>
                                    <outputDirectory>${client-registry-spec-dir}</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>
                                    ${project.build.directory}/generated-sources/${codegen.base.package.name}/oracle-java-sdk-sources
                                </source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.oracle.helidon.oci</groupId>
                <artifactId>helidon-oci-repackage-plugin</artifactId>
                <version>1.2.1-SNAPSHOT</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage-oci-libs</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <artifacts>
                        <artifact>
                            <groupId>com.oracle.pic.kiev</groupId>
                            <artifactId>shared-models</artifactId>
                        </artifact>
                    </artifacts>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.oracle.bmc.sdk</groupId>
                <artifactId>bmc-sdk-swagger-maven-plugin</artifactId>
                <version>2.135-3.72.0</version>
                <executions>
                    <execution>
                        <id>generate-frontend-s2s-client</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <language>oracle-java-sdk</language>
                            <basePackage>${codegen.base.package.name}</basePackage>
                            <specPath>${frontend-spec-file}</specPath>
                            <additionalProperties>
                                <!-- Switch the default client configurator to NonBuffering as is relevant to streaming large payloads -->
                                <defaultClientConfigurator>com.oracle.bmc.http.DefaultConfigurator.NonBuffering</defaultClientConfigurator>
                                <generateWaiters>false</generateWaiters>
                                <generatePaginators>false</generatePaginators>
                                <useExplicitlySetFilter>false</useExplicitlySetFilter>
                            </additionalProperties>
                            <outputDir>${project.build.directory}/generated-sources/${codegen.base.package.name}</outputDir>
                            <specGenerationType>INTERNAL</specGenerationType>
                            <isTestGenerationEnabled>false</isTestGenerationEnabled>
                            <isExpect100ContinueSupported>false</isExpect100ContinueSupported>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-client-registry-s2s-client</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <language>oracle-java-sdk</language>
                            <basePackage>${codegen.base.package.name}</basePackage>
                            <specPath>${client-registry-spec-file}</specPath>
                            <additionalProperties>
                                <generateWaiters>false</generateWaiters>
                                <generatePaginators>false</generatePaginators>
                                <useExplicitlySetFilter>false</useExplicitlySetFilter>
                            </additionalProperties>
                            <outputDir>${project.build.directory}/generated-sources/${codegen.base.package.name}</outputDir>
                            <specGenerationType>INTERNAL</specGenerationType>
                            <isTestGenerationEnabled>false</isTestGenerationEnabled>
                            <isExpect100ContinueSupported>false</isExpect100ContinueSupported>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>