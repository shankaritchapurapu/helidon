<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://maven.apache.org/POM/4.0.0"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.oracle.helidon.oci</groupId>
        <artifactId>helidon-oci-project</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>helidon-repackaged-oci</artifactId>
    <name>Helidon OCI Repackaged Native Modules</name>
    <packaging>pom</packaging>

    <modules>
        <module>transpile-maven-plugin</module>
        <module>repackaged-oci-sdk-oci-internals-commons</module>
        <module>repackaged-oci-vault-java-sdk</module>
    </modules>


    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>get-spec-from-artifactory</id>
                            <phase>initialize</phase>
                            <goals>
                                <goal>unpack</goal>
                            </goals>
                            <configuration>
                                <artifactItems>
                                    <artifactItem>
                                        <groupId>${codegen.artifactory.groupId}</groupId>
                                        <artifactId>${codegen.artifactory.artifactId}</artifactId>
                                        <version>${codegen.artifactory.version}</version>
                                        <type>jar</type>
                                        <includes>${codegen.spec.name}</includes>
                                        <outputDirectory>${codegen.spec.dir}</outputDirectory>
                                    </artifactItem>
                                </artifactItems>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>com.oracle.bmc.sdk</groupId>
                    <artifactId>bmc-sdk-swagger-maven-plugin</artifactId>
                    <version>${bmc-sdk-swagger-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>java-sdk-spec</id>
                            <phase>generate-sources</phase>
                            <goals>
                                <goal>generate</goal>
                            </goals>
                            <configuration>
                                <language>oracle-java-sdk</language>
                                <specPath>${codegen.spec.swagger}</specPath>
                                <basePackage>${codegen.base.package.name}</basePackage>
                                <additionalProperties>
                                    <!--
                                    Note that this setting can only be used for endpoints following the
                                    '<service>.<region>.oraclecloud.com' pattern. To use other endpoint formats,
                                    specify the endpoint template in your spec.

                                    See https://confluence.oci.oraclecorp.com/display/DEX/Service+Endpoint+Update
                                    -->
                                    <serviceGroupEndpoint>${codegen.endpoint}</serviceGroupEndpoint>
                                    <serviceGroupName>${codegen.serviceGroupName}</serviceGroupName>
                                    <generateWaiters>${codegen.generate.waiters}</generateWaiters>
                                    <generatePaginators>${codegen.generate.paginators}</generatePaginators>
                                    <useExplicitlySetFilter>${codegen.use.explicitly.set.filter}</useExplicitlySetFilter>
                                    <!-- Making SecretService client "non-regional".
                                         That sounds strange, because SecretService is definitely present
                                         in different regions. What this does, however, is remove the
                                         "setRegion" method, which doesn't work anyway, since (1) there
                                         are two different endpoints, depending on whether the request
                                         originates in the Customer Enclave or the Service Enclave; and
                                         (2) the endpoints do not use the domain names that the public
                                         OCI Java SDK assumes, like oraclecloud.com for OC1.

                                         See https://confluence.oci.oraclecorp.com/display/DEVCENTRAL/Java+SDK+to+Manage+Secrets+in+the+Control+Plane' -->
                                    <isRegionalClient.SecretService>false</isRegionalClient.SecretService>
                                </additionalProperties>
                                <outputDir>${project.build.directory}/generated-sources/${codegen.base.package.name}</outputDir>
                                <specGenerationType>${codegen.specGenerationType}</specGenerationType>
                                <isTestGenerationEnabled>${codegen.is.test.generation.enabled}</isTestGenerationEnabled>
                                <isExpect100ContinueSupported>${codegen.is.expect.100.continue.supported}
                                </isExpect100ContinueSupported>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>add-source-root</id>
                            <phase>generate-sources</phase>
                            <goals>
                                <goal>add-source</goal>
                            </goals>
                            <configuration>
                                <sources>
                                    <source>
                                        ${project.build.directory}/generated-sources/${codegen.base.package.name}/oracle-java-sdk-sources
                                    </source>
                                </sources>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.projectlombok</groupId>
                    <artifactId>lombok-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>delombok</id>
                            <phase>process-sources</phase>
                            <goals>
                                <goal>delombok</goal>
                            </goals>
                            <configuration>
                                <addOutputDirectory>false</addOutputDirectory>
                                <!-- Only delombok for docs -->
                                <outputDirectory>target/generated-sources-for-docs/delombok</outputDirectory>
                                <sourceDirectory>
                                    ${project.build.directory}/generated-sources/${codegen.base.package.name}/oracle-java-sdk-sources
                                </sourceDirectory>
                                <encoding>UTF-8</encoding>
                                <formatPreferences>
                                    <javaLangAsFQN>skip</javaLangAsFQN>
                                    <generateDelombokComment>skip</generateDelombokComment>
                                    <generated>skip</generated>
                                    <indent>4</indent>
                                    <suppressWarnings>skip</suppressWarnings>
                                </formatPreferences>
                                <verbose>true</verbose>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <goals>
                        <goal>jar</goal>
                    </goals>
                    <executions>
                        <execution>
                            <id>aggregate</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <doclet>ch.raffael.doclets.pegdown.PegdownDoclet</doclet>
                        <docletArtifact>
                            <groupId>ch.raffael.pegdown-doclet</groupId>
                            <artifactId>pegdown-doclet</artifactId>
                            <version>1.3</version>
                        </docletArtifact>
                        <useStandardDocletOptions>true</useStandardDocletOptions>
                        <aggregate>true</aggregate>
                        <minmemory>128m</minmemory>
                        <maxmemory>1024m</maxmemory>
                        <additionalparam>-Xdoclint:none -disable-highlight</additionalparam>
                        <sourcepath>target/generated-sources-for-docs/delombok</sourcepath>
                        <links>
                            <link>https://jax-rs-spec.java.net/nonav/2.0-rev-a/apidocs</link>
                            <link>https://docs.cloud.oracle.com/iaas/tools/java/latest</link>
                        </links>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>